{
  "name": "buildernet",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready SaaS Website Builder",
  "scripts": {
    "dev": "pnpm run --parallel dev",
    "dev:web": "pnpm --filter web dev",
    "dev:web:3001": "pnpm --filter web dev -- -p 3001",
    "build": "pnpm run -r build",
    "build:web": "pnpm --filter web build",
    "db:generate": "pnpm --filter @buildernet/database generate",
    "db:push": "pnpm --filter @buildernet/database push",
    "db:studio": "pnpm --filter @buildernet/database studio",
    "db:seed": "pnpm --filter web db:seed",
    "lint": "pnpm run -r lint"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0"
}
